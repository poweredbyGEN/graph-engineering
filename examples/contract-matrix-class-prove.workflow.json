{
  "version": "graph-engineering/v1alpha1",
  "id": "contract_matrix_class_prove",
  "goal": "Probe the real contract matrix once, then stream each independent class through implementation and proof before one final integration gate",
  "budgets": {"max_nodes": 4, "max_concurrency": 2, "max_attempts_per_node": 2, "max_total_attempts": 8, "timeout_seconds": 2400},
  "nodes": [
    {
      "id": "probe_contract_matrix",
      "kind": "agent",
      "task": "Run bounded experiments against the current implementation and return the observed contract matrix. Do not infer unsupported classes and do not edit code.",
      "needs": [],
      "inputs": {},
      "outputs": {"matrix": {"schema": {"type": "object", "additionalProperties": false, "required": ["classes", "observations"], "properties": {"classes": {"type": "array", "minItems": 2, "maxItems": 20, "items": {"type": "string"}}, "observations": {"type": "object"}}}}},
      "profile": "verification",
      "workspace": "read-only",
      "permission": "read",
      "effect": "read",
      "checks": [{"id": "matrix_probe", "argv": ["python3", "tools/contract_class_gate.py", "--check-matrix"]}],
      "retry": {"max_attempts": 2, "no_progress_limit": 1},
      "required": true
    },
    {
      "id": "class_alpha_prove",
      "kind": "agent",
      "task": "Implement and prove only class alpha from the observed matrix. Finish its deterministic class proof before returning; do not wait for other classes.",
      "needs": ["probe_contract_matrix"],
      "inputs": {"matrix": "probe_contract_matrix.matrix"},
      "outputs": {
        "proof": {"schema": {"type": "object", "additionalProperties": false, "required": ["class", "cases", "evidence"], "properties": {"class": {"const": "alpha"}, "cases": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "string"}}}}},
        "changeset": {"schema": {"type": "object", "additionalProperties": false, "required": ["base_sha", "patch_b64", "untracked_b64", "changed_paths", "digest"], "properties": {"base_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "patch_b64": {"type": "string"}, "untracked_b64": {"type": "object", "additionalProperties": {"type": "string"}}, "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
      },
      "profile": "implementation",
      "workspace": "worktree",
      "write_scope": ["src/classes/alpha", "tests/classes/alpha"],
      "permission": "write",
      "effect": "none",
      "checks": [{"id": "alpha_class_proof", "argv": ["python3", "tools/contract_class_gate.py", "--class", "alpha"]}],
      "retry": {"max_attempts": 2, "no_progress_limit": 1},
      "required": true
    },
    {
      "id": "class_beta_prove",
      "kind": "agent",
      "task": "Implement and prove only class beta from the observed matrix. Finish its deterministic class proof before returning; do not wait for other classes.",
      "needs": ["probe_contract_matrix"],
      "inputs": {"matrix": "probe_contract_matrix.matrix"},
      "outputs": {
        "proof": {"schema": {"type": "object", "additionalProperties": false, "required": ["class", "cases", "evidence"], "properties": {"class": {"const": "beta"}, "cases": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "string"}}}}},
        "changeset": {"schema": {"type": "object", "additionalProperties": false, "required": ["base_sha", "patch_b64", "untracked_b64", "changed_paths", "digest"], "properties": {"base_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "patch_b64": {"type": "string"}, "untracked_b64": {"type": "object", "additionalProperties": {"type": "string"}}, "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
      },
      "profile": "implementation",
      "workspace": "worktree",
      "write_scope": ["src/classes/beta", "tests/classes/beta"],
      "permission": "write",
      "effect": "none",
      "checks": [{"id": "beta_class_proof", "argv": ["python3", "tools/contract_class_gate.py", "--class", "beta"]}],
      "retry": {"max_attempts": 2, "no_progress_limit": 1},
      "required": true
    },
    {
      "id": "integrate_proven_classes",
      "kind": "integration",
      "task": "Integrate only class lanes that completed their own proof and run the cross-class compatibility gate.",
      "needs": ["class_alpha_prove", "class_beta_prove"],
      "inputs": {"alpha": "class_alpha_prove.changeset", "beta": "class_beta_prove.changeset"},
      "outputs": {"result": {"schema": {"type": "object", "additionalProperties": false, "required": ["base_sha", "changed_paths", "change_digests", "integration_digest"], "properties": {"base_sha": {"type": "string"}, "changed_paths": {"type": "array", "items": {"type": "string"}}, "change_digests": {"type": "array", "items": {"type": "string"}}, "integration_digest": {"type": "string"}}}}},
      "workspace": "worktree",
      "write_scope": ["src/classes", "tests/classes"],
      "permission": "write",
      "checks": [{"id": "cross_class_compatibility", "argv": ["python3", "tools/contract_class_gate.py", "--check-integrated"]}],
      "retry": {"max_attempts": 1, "no_progress_limit": 1},
      "required": true
    }
  ],
  "outputs": {"result": "integrate_proven_classes.result"}
}
