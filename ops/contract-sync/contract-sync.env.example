# contract-sync environment. Copy to /etc/contract-sync.env (mode 0600, root)
# and fill in the value. Nothing here is read from the repository.

# Gitea personal access token used for the API calls: open a PR, list/merge
# pull requests, read commit statuses. Needs write access to every repo in the
# consumer list (scope: repo). Never logged, never passed on a command line --
# the script only ever puts it in a curl Authorization header.
GEN_GITEA_TOKEN=

# Plane key used to file one stall ticket when a sync PR stays red for two
# consecutive ticks (project GEN, header X-API-Key). Optional: without it the
# sync only logs that the ticket could not be opened and retries next tick.
PLANE_API_KEY=

# Optional overrides, all with sane defaults in the script:
#
# GEN_GITEA_URL=https://git.gen.pro
# CONTRACT_SYNC_OWNER=GEN
# CONTRACT_SYNC_MCP_URL=https://git.gen.pro/GEN/gen-mcp-server.git
# CONTRACT_SYNC_MCP_BRANCH=main
# CONTRACT_SYNC_STATE_DIR=/var/lib/contract-sync
# CONTRACT_SYNC_PLANE_URL=https://plane.gen.pro
# CONTRACT_SYNC_CONSUMERS="gen-mcp-server gen-agentic limitless-fe api-docs"
# CONTRACT_SYNC_STATUS_POLL_TIMEOUT=900
# DRY_RUN=1

# Note: git push/clone credentials do NOT come from here. They come from the
# box's git credential helper for git.gen.pro, which reads /etc/gen-gitea.env.
