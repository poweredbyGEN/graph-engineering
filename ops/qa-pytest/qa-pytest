#!/bin/bash
# qa-pytest <worktree-dir> <pytest args...>
# QA_PYTEST_NETWORK selects the docker network mode (default none). The release
# preflight sets bridge only for a step whose offline failure CI does not show
# (GEN-9456); lane runs stay offline.
# Runs gen-agentic tests for a lane in the QA image. Slots 1-3 are always available;
# slots 4-6 open only while the 1-minute load is under 12 (16 cores): CI agents and
# staging share this box, and uncapped lane runs slowed CI ~11x.
set -euo pipefail
dir=${1:?usage: qa-pytest <dir> <pytest args...>}; shift
dir=$(realpath -m "$dir")
docker_options=()
if [ -n "${PYTEST_ENV_FILE:-}" ]; then docker_options+=(--env-file "$PYTEST_ENV_FILE"); fi
lockdir=/run/qa-pytest; mkdir -p "$lockdir"

# Overflow: when every local slot is busy, run on the dedicated lane runner
# (lane-runner-ash-1, 4 slots x 4 CPUs). A dir holding Unix sockets depends on a
# Postgres container running here, so it always stays local.
RUNNER=${QA_LANE_RUNNER:-100.116.155.101}
remote_run() {
  local img=${PYTEST_IMAGE:-root-gen8396-qa:7b26687d}
  # The runner gets a mirror (rsync --delete) of $dir. A relative dir such as "."
  # resolves to the runner home, and a mirror of it deleted /root/.ssh there
  # (2026-10-09). Only absolute lane dirs under /mnt/data are mirrored.
  case "$dir" in /mnt/data/?*) ;; *) return 1 ;; esac
  ssh -o BatchMode=yes -o ConnectTimeout=5 root@$RUNNER true 2>/dev/null || return 1
  rsync -a --delete "$dir/" root@$RUNNER:"$dir/" || return 1
  if [ -n "${PYTEST_ENV_FILE:-}" ]; then rsync -a "$PYTEST_ENV_FILE" root@$RUNNER:"$PYTEST_ENV_FILE" || return 1; fi
  ssh root@$RUNNER "docker image inspect $img >/dev/null 2>&1" || docker save "$img" | ssh root@$RUNNER docker load >/dev/null || return 1
  echo "qa-pytest: running on lane runner $RUNNER" >&2
  # A dropped runner connection must fail the run, never hang the lane: keepalive plus a hard cap.
  timeout 5400 ssh -o BatchMode=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=4 root@$RUNNER "PYTEST_ENV_FILE=${PYTEST_ENV_FILE:-} QA_PYTEST_NETWORK=${QA_PYTEST_NETWORK:-none} PYTEST_IMAGE=$img PYTEST_MODULE=${PYTEST_MODULE:-pytest} qa-pytest $(printf '%q ' "$dir" "$@")"
  rc=$?
  # Test outputs written on the runner come back to the lane dir.
  rsync -a root@$RUNNER:"$dir/" "$dir/" || true
  exit $rc
}
# Lanes run on lane-runner-ash-1 by default; a dir holding Unix sockets needs the local Postgres.
if [ -z "$(find "$dir" -maxdepth 3 -type s -print -quit 2>/dev/null)" ]; then remote_run "$@" || true; fi
# The shared /deps holds gen-agentic (py3.11) wheels; mcp-cifix-qa (py3.12) and limitless-data-ci (py3.10) images bundle their own deps.
case "${PYTEST_IMAGE:-root-gen8396-qa:7b26687d}" in mcp-cifix-qa*|limitless-data-ci*) deps_mount=(); deps_path="" ;; *) deps_mount=(-v /mnt/data/qa-lanes/release1-01a10810/deps:/deps); deps_path=":/deps" ;; esac
for try in $(seq 1 720); do
  for slot in 1 2 3 4 5 6; do
    if [ "$slot" -gt 3 ] && [ "$(cut -d. -f1 /proc/loadavg)" -ge 12 ]; then break; fi
    exec 9>"$lockdir/slot$slot"
    if flock -n 9; then
      exec docker run --rm --network "${QA_PYTEST_NETWORK:-none}" --cpus 4 --memory 6g \
        "${docker_options[@]}" -v "$dir":/work ${deps_mount[@]} -w /work \
        -e PYTHONPATH=/work/src${deps_path} "${PYTEST_IMAGE:-root-gen8396-qa:7b26687d}" python -m "${PYTEST_MODULE:-pytest}" "$@"
    fi
  done
  [ "$try" = 1 ] && echo "qa-pytest: all slots busy or load high, waiting" >&2
  sleep 5
done
echo "qa-pytest: no slot free after 60 min" >&2; exit 75
