#!/usr/bin/env bash
# CLI v1: ci-fetch-pinned <GEN repo name> <full commit SHA> <destination>.
set -eu
if [ "$#" -ne 3 ]; then
  echo 'PINNED_FETCH_INPUT expected repo sha dest' >&2; exit 1
fi
repo=$1 sha=$2 dest=$3
if [[ ! $repo =~ ^[a-zA-Z0-9_-]+$ || ! $sha =~ ^[0-9a-f]{40}$ || -z $dest ]]; then
  echo 'PINNED_FETCH_INPUT expected repo full-sha nonempty-dest' >&2; exit 1
fi
if [ -z "${GEN_GITEA_READ_TOKEN:-}" ]; then
  echo 'PINNED_FETCH_AUTH' >&2; exit 1
fi
export GIT_TERMINAL_PROMPT=0 LC_ALL=C
export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=http.extraHeader
export GIT_CONFIG_VALUE_0="Authorization: token $GEN_GITEA_READ_TOKEN"
export GIT_CONFIG_KEY_1=http.userAgent GIT_CONFIG_VALUE_1=gen-build-gate
# Abort stalled HTTP transfers by lack of progress, not by the age of healthy downloads.
export GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30
log=$(mktemp)
trap 'rm -f "$log"' EXIT
mkdir -p "$dest"
git -C "$dest" init --quiet
for attempt in 1 2 3; do
  printf 'ci-fetch-pinned %s %s attempt %s/3 start\n' "$repo" "$sha" "$attempt"
  if git -C "$dest" fetch --quiet --depth 1 "https://git.gen.pro/GEN/$repo.git" "$sha" 2>"$log"; then
    # Fetch exit zero is insufficient: both the fetched object and detached checkout must be the pin.
    # Every sibling-source consumer extends this helper; never substitute a branch or cached checkout.
    if [ "$(git -C "$dest" rev-parse FETCH_HEAD)" != "$sha" ] ||
       ! git -C "$dest" checkout --quiet --detach "$sha" ||
       [ "$(git -C "$dest" rev-parse HEAD)" != "$sha" ]; then
      echo 'PINNED_FETCH_MISMATCH' >&2; exit 1
    fi
    printf 'ci-fetch-pinned %s %s attempt %s/3 ok\n' "$repo" "$sha" "$attempt"
    exit 0
  fi
  # These are Git transport diagnostics, not product-text intent. Permanent refusals never retry.
  if grep -Eq 'Authentication failed|error: 40[13]|could not read Username|terminal prompts disabled' "$log"; then
    echo 'PINNED_FETCH_AUTH' >&2; exit 1
  fi
  if grep -Eq 'not our ref|unadvertised object|couldn.t find remote ref' "$log"; then
    printf 'PINNED_FETCH_MISSING %s %s\n' "$repo" "$sha" >&2; exit 1
  fi
  case "$attempt" in
    1) sleep 5 ;;
    2) sleep 15 ;;
  esac
done
printf 'PINNED_FETCH_STALLED %s %s after 3 attempts\n' "$repo" "$sha" >&2
exit 1
