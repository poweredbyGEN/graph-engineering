#!/usr/bin/env bash
set -euo pipefail

# Keep durable task state out of source trees while preserving one graph per git project.
project_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
if command -v sha256sum >/dev/null 2>&1; then
  project_key=$(printf '%s' "$project_root" | sha256sum | cut -c1-20)
else
  # macOS ships shasum rather than GNU sha256sum.
  project_key=$(printf '%s' "$project_root" | shasum -a 256 | cut -c1-20)
fi
state_home=${GRAPH_ENGINEERING_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/graph-engineering}
graph_state="$state_home/task-graphs/$project_key"

mkdir -p "$graph_state/media" "$graph_state/logs"

exec task-graph-mcp \
  --database "$graph_state/tasks.db" \
  --media-dir "$graph_state/media" \
  --log-dir "$graph_state/logs" \
  --stdio
