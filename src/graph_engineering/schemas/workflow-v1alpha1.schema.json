{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/poweredbyGEN/graph-engineering/schemas/workflow-v1alpha1.schema.json",
  "title": "graph-engineering workflow v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "goal", "budgets", "nodes", "outputs"],
  "properties": {
    "version": {"const": "graph-engineering/v1alpha1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "product_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generation", "digest"],
      "properties": {
        "version": {"const": "graph-engineering/product-contract/v2"},
        "generation": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_nodes", "max_concurrency", "max_attempts_per_node", "max_total_attempts", "timeout_seconds"],
      "properties": {
        "max_nodes": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_attempts_per_node": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_total_attempts": {"type": "integer", "minimum": 1, "maximum": 10000},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 604800}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/node"}
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}\\.[a-z][a-z0-9_-]{0,63}$"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": {"oneOf": [{"type": "object"}, {"type": "string", "minLength": 1}]},
        "acceptance_schema": {"type": "object"},
        "required": {"type": "boolean", "default": true}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
        "no_progress_limit": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_elapsed_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "max_deterministic_checks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "Maximum deterministic acceptance-check evaluations across attempts."
        },
        "max_commands": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "deprecated": true,
          "description": "Compatibility alias for max_deterministic_checks; it never counts provider/tool commands."
        }
      },
      "not": {"required": ["max_deterministic_checks", "max_commands"]}
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"enum": ["all", "all_settled", "any", "n_of_m", "majority"]},
        "n": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"policy": {"const": "n_of_m"}}},
          "then": {"required": ["n"]},
          "else": {"not": {"required": ["n"]}}
        }
      ]
    },
    "repairTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "input"],
      "properties": {
        "node": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "input": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
      }
    },
    "repairRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check_ids", "targets", "max_rounds", "no_progress_limit"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "check_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
        },
        "targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/repairTarget"}
        },
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 10},
        "no_progress_limit": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes"],
      "properties": {
        "routes": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {"$ref": "#/$defs/repairRoute"}
        }
      }
    },
    "fallbackRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile", "on_codes", "max_uses"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "on_codes": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
        },
        "max_uses": {"const": 1}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes"],
      "properties": {
        "routes": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {"$ref": "#/$defs/fallbackRoute"}
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {"enum": ["equals", "not_equals", "in", "exists", "gt", "gte", "lt", "lte", "type_is"]},
        "value": {},
        "values": {"type": "array", "maxItems": 1000}
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "in"}}}, "then": {"required": ["values"]}},
        {"if": {"properties": {"op": {"enum": ["equals", "not_equals", "gt", "gte", "lt", "lte", "type_is"]}}}, "then": {"required": ["value"]}}
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "output"],
      "properties": {
        "name": {"enum": ["schema_validate", "select", "map", "stable_union", "dedupe", "sort", "typed_predicate", "risk_router", "verdict_reducer"]},
        "output": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "config": {"type": "object", "maxProperties": 100}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "predicate"],
      "properties": {
        "source": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}\\.[a-z][a-z0-9_-]{0,63}$"},
        "path": {"type": "array", "maxItems": 32, "items": {"oneOf": [{"type": "string"}, {"type": "integer", "minimum": 0}]}},
        "predicate": {"$ref": "#/$defs/predicate"}
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "output", "predicate", "max_iterations"],
      "properties": {
        "target": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "output": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "path": {"type": "array", "maxItems": 32, "items": {"oneOf": [{"type": "string"}, {"type": "integer", "minimum": 0}]}},
        "predicate": {"$ref": "#/$defs/predicate"},
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "task", "needs", "inputs", "outputs", "workspace", "permission", "required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "kind": {"enum": ["agent", "transform", "check", "approval", "integration"]},
        "task": {"type": "string", "minLength": 1, "maxLength": 8000},
        "needs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
        "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/artifact"}},
        "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "model": {"type": "string", "minLength": 1},
        "workspace": {"enum": ["read-only", "worktree", "shared"]},
        "write_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "permission": {"enum": ["read", "write", "external", "destructive"]},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "retry": {"$ref": "#/$defs/retry"},
        "progress": {"$ref": "#/$defs/progress"},
        "join": {"$ref": "#/$defs/join"},
        "repair": {"$ref": "#/$defs/repair"},
        "fallback": {"$ref": "#/$defs/fallback"},
        "operation": {"$ref": "#/$defs/operation"},
        "route": {"$ref": "#/$defs/route"},
        "loop": {"$ref": "#/$defs/loop"},
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "target"],
          "properties": {
            "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
            "target": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
          }
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "required": {"type": "boolean"},
        "approval": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "effect": {
          "enum": ["none", "read", "idempotent_write", "non_idempotent_write"]
        },
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "agent"}}}, "then": {"required": ["profile"]}},
        {"if": {"properties": {"permission": {"enum": ["external", "destructive"]}}}, "then": {"required": ["approval", "effect"]}},
        {"if": {"required": ["effect"], "properties": {"effect": {"const": "idempotent_write"}}}, "then": {"required": ["idempotency_key"]}}
      ]
    }
  }
}
